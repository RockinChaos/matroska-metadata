{
  "version": "1.1.2",
  "name": "@rockinchaos/matroska-metadata",
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "description": "A lightweight Matroska/WebM metadata reader for Node.js and browsers, with EBML SeekHead-based metadata lookup.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint src test eslint.config.js",
    "lint:fix": "eslint src test eslint.config.js --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier src test .github package.json pnpm-workspace.yaml tsconfig.json eslint.config.js .prettierrc.json \"*.md\" --write --no-error-on-unmatched-pattern",
    "format:check": "prettier src test .github package.json pnpm-workspace.yaml tsconfig.json eslint.config.js .prettierrc.json \"*.md\" --check --no-error-on-unmatched-pattern",
    "check": "run-s lint typecheck format:check test",
    "test": "node --test"
  },
  "browser": {
    "zlib": "./src/inflateWeb.js"
  },
  "keywords": [],
  "author": {
    "name": "RockinChaos",
    "url": "https://github.com/RockinChaos"
  },
  "contributors": [
    {
      "name": "ThaUnknown",
      "url": "https://github.com/ThaUnknown"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RockinChaos/matroska-metadata.git"
  },
  "bugs": {
    "url": "https://github.com/RockinChaos/matroska-metadata/issues"
  },
  "dependencies": {
    "@rockinchaos/ebml-iterator": "github:RockinChaos/ebml-iterator#157dec919d7b02485ede2c6418063b40556dbc67",
    "fast-readable-async-iterator": "^2.0.0",
    "pako": "^3.0.3",
    "uint8-util": "^2.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "typescript": "6.0.3"
  }
}
